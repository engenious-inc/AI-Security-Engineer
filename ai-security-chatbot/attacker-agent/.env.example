# ChatRaider — copy to .env:   cp .env.example .env
# Runs WITHOUT any keys — every attack message is scripted. Add an attacker-brain model to let it
# rephrase a seed message when the bot refuses it; everything else stays the same either way.

# ---- TARGET (default: your own ai-security-chatbot on localhost; non-localhost needs ROE_AUTHORIZED) ----
TARGET_URL=http://localhost:5000

# The seeded "victim" account ChatRaider logs into ONCE, just to create a ticket to attack. Every
# attack after that is sent unauthenticated — none of the five findings require the attacker to
# have an account at all, which is itself part of the point.
VICTIM_EMAIL=customer@example.com
VICTIM_PASSWORD=customer123

# ---- THE BRAIN (optional). Leave blank to run fully scripted. ----
# PROVIDER picks the wire format. "openai" (default) covers OpenRouter / OpenAI / local servers
# (Ollama, LM Studio) — anything speaking /chat/completions. "anthropic" uses the native Messages API.
# Leave BASE_URL blank to use the provider's default base URL. Uncomment ONE block below.
#
#   --- OpenAI directly ---
# ATTACKER_LLM_PROVIDER=openai
# ATTACKER_LLM_API_KEY=sk-...
# ATTACKER_LLM_MODEL=gpt-4o-mini
#
#   --- Anthropic (native) ---
# ATTACKER_LLM_PROVIDER=anthropic
# ATTACKER_LLM_API_KEY=sk-ant-...
# ATTACKER_LLM_MODEL=claude-haiku-4-5-20251001
#
#   --- OpenRouter (the cohort fallback key works here) ---
# ATTACKER_LLM_PROVIDER=openai
# ATTACKER_LLM_BASE_URL=https://openrouter.ai/api/v1
# ATTACKER_LLM_API_KEY=sk-or-...
# ATTACKER_LLM_MODEL=openai/gpt-4o-mini
#
#   --- Local, free, no bans (Ollama / LM Studio) ---
# ATTACKER_LLM_PROVIDER=openai
# ATTACKER_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ATTACKER_LLM_API_KEY=local
# ATTACKER_LLM_MODEL=llama3.1

# ---- CAMPAIGN KNOBS (all optional) ----
# ATTACK_DELAY_MS=400     # pause between calls
# MAX_TURNS=3             # messages per ladder-style strategy before giving up
# REPRO_RUNS=3            # verify: replay attempts
# REPRO_MIN=2             # verify: how many of those must hit to CONFIRM
# RC_DASHBOARD_PORT=8788

# ---- AUTHORIZED ENGAGEMENT (beyond your own local instance) — leave OFF for the cohort ----
# ROE_AUTHORIZED=1
# TARGET_ALLOWLIST=staging.client.example
